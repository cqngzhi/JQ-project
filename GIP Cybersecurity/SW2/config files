enable
configure terminal

hostname ASW2
no logging console
logging buffered 16384 informational
logging trap warnings
service timestamps log datetime msec localtime
service timestamps debug datetime msec localtime
logging host 10.38.100.23
logging source-interface vlan 99
no ip domain-lookup
ip domain-name JQLab.local
banner motd #Authorized Access Only!#
enable secret cisco
service password-encryption
ip dhcp snooping vlan 10,20
ip arp inspection vlan 10,20

line console 0
password cisco
login
exit

crypto key generate rsa general-keys modulus 2048
username admin secret cisco
ip ssh version 2
ip ssh time-out 60
ip ssh authentication-retries 3
ip access-list standard ACL_MGMT
permit 10.38.100.0 0.0.0.255
permit 10.38.99.0 0.0.0.255
deny any log
exit

line vty 0 15
access-class ACL_MGMT in
transport input ssh
exec-timeout 10 0
login local
exit

ip default-gateway 10.38.99.254

spanning-tree mode rapid-pvst
spanning-tree vlan 10,20,99,100 priority 36864

vlan 10
name Clients
exit
vlan 20
name Wireless
exit
vlan 99
name Management
exit
vlan 100
name Servers
exit
vlan 999
name UNUSED_BLACKHOLE
exit

interface range fastEthernet 0/1-2
spanning-tree portfast
spanning-tree bpduguard enable
switchport mode access
switchport access vlan 10
switchport port-security maximum 5
switchport port-security violation restrict
switchport port-security mac-address sticky
no ip dhcp snooping trust   
no shutdown
exit

interface range fastEthernet 0/3-4
spanning-tree portfast
spanning-tree bpduguard enable
switchport mode access
switchport access vlan 20
switchport port-security maximum 10
switchport port-security violation restrict
switchport port-security mac-address sticky
no ip dhcp snooping trust   
no shutdown
exit

interface range fastEthernet 0/5-6
spanning-tree portfast
spanning-tree bpduguard enable
switchport mode access
switchport access vlan 100
switchport port-security maximum 10
switchport port-security violation restrict
switchport port-security mac-address sticky
no shutdown
exit

interface range gigabitethernet 0/1-2
ip dhcp snooping trust
ip arp inspection trust
spanning-tree bpduguard disable 
spanning-tree portfast disable 
switchport mode trunk
switchport trunk allowed vlan 10,20,99,100
switchport trunk native vlan 99
switchport port-security maximum 5
switchport port-security violation restrict
switchport port-security mac-address sticky
switchport nonegotiate
no shutdown
exit

interface range fastEthernet 0/7-8
description Management_PC_Link
switchport mode access
switchport access vlan 99
switchport port-security maximum 10
switchport port-security violation restrict
switchport port-security mac-address sticky
spanning-tree portfast           
spanning-tree bpduguard enable    
no ip dhcp snooping trust         
no shutdown
exit

interface range fastEthernet 0/9-24
switchport mode access
switchport access vlan 999
shutdown
exit

interface vlan 99
ip address 10.38.99.250 255.255.255.0
no shutdown
exit

interface vlan 1
shutdown
exit

no snmp-server community public
no snmp-server community private
snmp-server group SNMP_GROUP v3 priv
snmp-server group SNMP_GROUP v3 priv access ACL_MGMT
snmp-server user snmpadmin SNMP_GROUP v3 auth sha JQ-Lab_SNMPauth#1 priv aes 128 JQ-Lab_SNMPpriv#1
snmp-server location JQLab-Access-Switch-2
snmp-server contact admin@JQLab.local
snmp-server host 10.38.100.23 version 3 priv snmpadmin
snmp-server enable traps snmp authentication
snmp-server enable traps hsrp
snmp-server enable traps spanning-tree
snmp-server enable traps ospf

radius server Windows_NPS
address ipv4 10.38.100.21 auth-port 1812 acct-port 1813
key JQ-Lab_Radius_2026     
exit

aaa new-model
aaa authentication login VTY_AUTH group radius local
aaa authorization exec VTY_AUTH group radius local 

ip radius source-interface vlan 99

line vty 0 15
login authentication VTY_AUTH
authorization exec VTY_AUTH
transport input ssh
exit
