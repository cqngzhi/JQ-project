enable
configure terminal

hostname ASW1
no logging console
no ip domain-lookup
ip domain-name JQLab.local
banner motd #Authorized Access Only!#
enable secret cisco
service password-encryption

line console 0
password cisco
login
exit

crypto key generate rsa general-keys modulus 1024
username admin secret cisco
ip ssh version 2
line vty 0 15
transport input ssh
login local
exit

ip default-gateway 10.38.99.254

spanning-tree mode rapid-pvst
spanning-tree vlan 10,20,99,100 priority 32768

vlan 10
name Clients
exit
vlan 20
name Wireless
exit
vlan 99
name Management
exit
vlan 100
name Servers
exit

interface range fastEthernet 0/1-2
spanning-tree portfast
spanning-tree bpduguard enable
switchport mode access
switchport access vlan 10
no shutdown
exit

interface range fastEthernet 0/3-4
spanning-tree portfast
spanning-tree bpduguard enable
switchport mode access
switchport access vlan 20
no shutdown
exit

interface range fastEthernet 0/5-6
ip dhcp snooping trust
spanning-tree portfast
spanning-tree bpduguard enable
switchport mode access
switchport access vlan 100
no shutdown
exit

interface range fastEthernet 0/7-8, gigabitethernet 0/1-2
ip dhcp snooping trust
spanning-tree bpduguard disable 
spanning-tree portfast disable 
switchport mode trunk
switchport trunk allowed vlan 10,20,99,100
switchport trunk native vlan 99
no shutdown
exit

interface range fastEthernet 0/9-24
shutdown
exit

interface vlan 99
ip address 10.38.99.251 255.255.255.0
no shutdown
exit

interface vlan 1
shutdown
exit

