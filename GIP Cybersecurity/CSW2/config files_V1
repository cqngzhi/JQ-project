enable
configure terminal
hostname CSW2
no logging console
logging buffered 32768 informational
logging trap warnings
service timestamps log datetime msec localtime
service timestamps debug datetime msec localtime
logging host 10.38.100.23
logging source-interface vlan 99
no ip domain-lookup
no service pad
no ip http server
no ip http secure-server
ip domain-name JQLab.local
enable secret cisco
service password-encryption
ip default-gateway 10.38.99.254
banner motd #Authorized Access Only!#
ip dhcp snooping vlan 10,20,99,100
ip arp inspection vlan 10,20,99,100
lldp run

crypto key generate rsa general-keys modulus 2048
username admin secret cisco
ip ssh version 2
ip ssh time-out 60
ip ssh authentication-retries 3
ip access-list standard ACL_MGMT
permit 10.38.100.0 0.0.0.255
permit 10.38.99.0 0.0.0.255
deny any log
exit

line vty 0 15
access-class ACL_MGMT in
transport input ssh
exec-timeout 10 0
login local
exit

line console 0
password cisco
login
exit

spanning-tree mode rapid-pvst
spanning-tree vlan 10,20,99,100 priority 8192

interface range GigabitEthernet 1/0/1 - 2
spanning-tree vlan 10 port-priority 64
exit
interface GigabitEthernet 1/0/23
spanning-tree vlan 10 port-priority 96
exit
interface GigabitEthernet 1/0/24
spanning-tree vlan 10 port-priority 128
exit

vlan 10
name Clients
exit
vlan 20
name Wireless
exit
vlan 99
name Management
exit
vlan 100
name Servers
exit
vlan 999
name UNUSED_BLACKHOLE
exit

interface vlan 1
shutdown
exit

interface vlan 10
ip helper-address 10.38.99.254
no ip proxy-arp
no ip redirects
no ip unreachables
no shutdown
exit

interface vlan 20
ip helper-address 10.38.99.254
no ip proxy-arp
no ip redirects
no ip unreachables
no shutdown
exit

interface vlan 99
ip address 10.38.99.252 255.255.255.0
ip helper-address 10.38.99.254
no ip proxy-arp
no ip redirects
no ip unreachables
no shutdown
exit

interface vlan 100
ip helper-address 10.38.99.254
no ip proxy-arp
no ip redirects
no ip unreachables
no shutdown
exit

interface range GigabitEthernet 1/0/1 - 2
channel-group 1 mode active  
exit
interface port-channel 1
switchport trunk encapsulation dot1q
switchport mode trunk
switchport trunk allowed vlan 10,20,99,100
no switchport trunk native vlan 99
switchport nonegotiate
no cdp enable
no shutdown
lldp transmit
lldp receive
exit

interface range GigabitEthernet 1/0/23 - 24
switchport trunk encapsulation dot1q
switchport mode trunk
switchport trunk allowed vlan 10,20,99,100
no switchport trunk native vlan 99
switchport nonegotiate
lldp transmit
lldp receive
no cdp enable
no shutdown
exit
interface GigabitEthernet 1/0/3
ip dhcp snooping trust
ip arp inspection trust
switchport trunk encapsulation dot1q
switchport mode trunk
switchport trunk allowed vlan 10,20,99,100
no switchport trunk native vlan 99
switchport nonegotiate
lldp transmit
lldp receive
no shutdown
exit

interface range GigabitEthernet 1/0/4 - 22
switchport mode access
switchport access vlan 999
shutdown
exit

no snmp-server community public
no snmp-server community private
snmp-server group SNMP_GROUP v3 priv
snmp-server group SNMP_GROUP v3 priv access ACL_MGMT
snmp-server user snmpadmin SNMP_GROUP v3 auth sha JQ-Lab_SNMPauth#1 priv aes 128 JQ-Lab_SNMPpriv#1
snmp-server location JQLab-Core-Switch-2
snmp-server contact admin@JQLab.local
snmp-server host 10.38.100.23 version 3 priv snmpadmin
snmp-server enable traps snmp authentication
snmp-server enable traps hsrp
snmp-server enable traps ospf

aaa new-model

radius server Windows_NPS
address ipv4 10.38.100.21 auth-port 1812 acct-port 1813
key JQ-Lab_Radius_2026
timeout 3
retransmit 2
exit

radius-server deadtime 10
ip radius source-interface vlan 99
aaa local authentication attempts max-fail 3

aaa authentication login VTY_AUTH group radius local
aaa authorization exec VTY_AUTH group radius local
aaa accounting exec VTY_ACCT start-stop group radius
aaa accounting commands 15 VTY_ACCT start-stop group radius

line vty 0 15
login authentication VTY_AUTH
authorization exec VTY_AUTH
accounting exec VTY_ACCT
transport input ssh
exit
