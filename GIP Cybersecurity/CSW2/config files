enable
configure terminal
hostname CSW2
no logging console
logging buffered 32768 informational
logging trap warnings
service timestamps log datetime msec localtime
service timestamps debug datetime msec localtime
logging host 10.38.100.23
logging source-interface vlan 99
no ip domain-lookup
ip domain-name JQLab.local
enable secret cisco
service password-encryption
ip routing
banner motd #Authorized Access Only!#
ip dhcp snooping vlan 10,20

crypto key generate rsa general-keys modulus 2048
username admin secret cisco
ip ssh version 2
ip ssh time-out 60
ip ssh authentication-retries 3
ip access-list standard ACL_MGMT
permit 10.38.100.23
permit 10.38.99.0 0.0.0.255
deny any log
exit

line vty 0 15
access-class ACL_MGMT in
transport input ssh
exec-timeout 10 0
login local
exit

line console 0
password cisco
login
exit

spanning-tree mode rapid-pvst
spanning-tree vlan 10,20,99,100 priority 8192

interface range GigabitEthernet 1/0/1 - 2
spanning-tree vlan 10 port-priority 64
exit
interface GigabitEthernet 1/0/23
spanning-tree vlan 10 port-priority 96
exit
interface GigabitEthernet 1/0/24
spanning-tree vlan 10 port-priority 128
exit

vlan 10
name Clients
exit
vlan 20
name Wireless
exit
vlan 99
name Management
exit
vlan 100
name Servers
exit

interface vlan 1
shutdown
exit

interface vlan 10
ip address 10.38.1.252 255.255.255.0
ip helper-address 10.38.100.21
no ip proxy-arp
no ip redirects
no ip unreachables
no shutdown
exit

interface vlan 20
ip address 10.38.2.252 255.255.255.0
ip helper-address 10.38.100.21
no ip proxy-arp
no ip redirects
no ip unreachables
no shutdown
exit

interface vlan 99
ip address 10.38.99.252 255.255.255.0
no ip proxy-arp
no ip redirects
no ip unreachables
no shutdown
exit

interface vlan 100
ip address 10.38.100.252 255.255.255.0
no ip proxy-arp
no ip redirects
no ip unreachables
no shutdown
exit


interface vlan 10
standby 10 ip 10.38.1.254
standby 10 priority 150
standby 10 preempt
standby 10 authentication md5 key-string JQ-Lab_Pa55.wrd!
exit

interface vlan 20
standby 20 ip 10.38.2.254
standby 20 priority 150
standby 20 preempt
standby 20 authentication md5 key-string JQ-Lab_Pa55.wrd!
exit

interface vlan 99
standby 1 ip 10.38.99.254
standby 1 priority 150
standby 1 preempt
standby 1 authentication md5 key-string JQ-Lab_Pa55.wrd!
exit

interface vlan 100
standby 30 ip 10.38.100.254
standby 30 priority 150
standby 30 preempt
standby 30 authentication md5 key-string JQ-Lab_Pa55.wrd!
exit

interface range GigabitEthernet 1/0/1 - 2
channel-group 1 mode active  
exit
interface port-channel 1
ip dhcp snooping trust
switchport trunk encapsulation dot1q
switchport mode trunk
switchport trunk allowed vlan 10,20,99,100
switchport trunk native vlan 99
no shutdown
exit

interface range GigabitEthernet 1/0/23 - 24
ip dhcp snooping trust
switchport trunk encapsulation dot1q
switchport mode trunk
switchport trunk allowed vlan 10,20,99,100
switchport trunk native vlan 99
switchport nonegotiate
no cdp enable
no shutdown
exit

interface range GigabitEthernet 1/0/4 - 22
shutdown
exit

interface GigabitEthernet 1/0/3
no switchport
ip address 10.38.255.17 255.255.255.252
ip ospf priority 254
ip ospf hello-interval 10 
ip ospf dead-interval 40
no ip proxy-arp
no ip redirects
no ip unreachables
no cdp enable
no shutdown
exit

interface loopback 0
ip address 2.2.2.2 255.255.255.255
ip ospf cost 10
exit

router ospf 1
network 2.2.2.2 0.0.0.0 area 0
network 10.38.1.0 0.0.0.255 area 0
network 10.38.2.0 0.0.0.255 area 0
network 10.38.99.0 0.0.0.255 area 0
network 10.38.100.0 0.0.0.255 area 0
network 10.38.255.16 0.0.0.3 area 0
router-id 2.2.2.2
passive-interface default
no passive-interface GigabitEthernet 1/0/3
exit

no snmp-server community public
no snmp-server community private
snmp-server group SNMP_GROUP v3 priv
snmp-server group SNMP_GROUP v3 priv access ACL_MGMT
snmp-server user snmpadmin SNMP_GROUP v3 auth sha JQ-Lab_SNMPauth#1 priv aes 128 JQ-Lab_SNMPpriv#1
snmp-server location JQLab-Core-Switch-1
snmp-server contact admin@JQLab.local
snmp-server host 10.38.100.23 version 3 priv snmpadmin
snmp-server enable traps snmp authentication
snmp-server enable traps hsrp
snmp-server enable traps spanning-tree
snmp-server enable traps ospf
