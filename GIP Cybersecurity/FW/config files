config system dns
set primary 195.130.131.4
set secondary 195.130.130.4
set source-ip 192.168.0.45
end

config system interface
    edit "Loopback0"
        set type loopback
        set ip 1.1.1.1 255.255.255.255
        set allowaccess ping
    next

    edit "lan2"
        append allowaccess ping
    next

    edit "lan3"
        append allowaccess ping
    next
end


config router ospf
    set router-id 1.1.1.1
    set default-information-originate always

    config network
        edit 1
            set prefix 1.1.1.1 255.255.255.255
            set area 0.0.0.0
        next

        edit 2
            set prefix 10.38.255.12 255.255.255.252
            set area 0.0.0.0
        next

        edit 3
            set prefix 10.38.255.16 255.255.255.252
            set area 0.0.0.0
        next
    end

    config ospf-interface
        edit "lan2"
            set interface "lan2"
            set hello-interval 10
            set dead-interval 40
            set authentication message-digest

            config md5-key
                edit 1
                    set key "JQ-Lab_OSPFkey!"
                next
            end
        next

        edit "lan3"
            set interface "lan3"
            set hello-interval 10
            set dead-interval 40
            set authentication message-digest

            config md5-key
                edit 1
                    set key "JQ-Lab_OSPFkey!"
                next
            end
        next
    end
end

config system snmp user
edit "snmpadmin"
set queries enable
set events enable
set security-level auth-priv
set auth-proto sha
set auth-pwd "JQ-Lab_SNMPauth#1"
set priv-proto aes128
set priv-pwd "JQ-Lab_SNMPpriv#1"
set source-ip 10.38.0.0 255.255.0.0
next
end

config system snmp sysinfo
set status enable
set contact-info "admin@JQLab.local"
set description "JQLab-Core-40F"
set location "JQLab-Belgium-Lab"
end

config system snmp target-host
edit 1
set ip 10.38.100.23
set status enable
set snmp-version v3
set user-name "snmpadmin"
set source-ip 10.38.255.14
next
end
