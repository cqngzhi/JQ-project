set ip 10.38.99.249 255.255.255.255
set allowaccess ping https ssh snmp
set type loopback
next
end

config router ospf
config network
edit 10
set prefix 10.38.99.249 255.255.255.255
set area 0.0.0.0
next
end
end

config router ospf
set router-id 1.1.1.1  
config network
edit 1
set prefix 10.38.99.249 255.255.255.250
