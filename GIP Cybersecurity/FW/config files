config system snmp user
edit "snmpadmin"
set queries enable
set events enable
set security-level auth-priv
set auth-proto sha
set auth-pwd "JQ-Lab_SNMPauth#1"
set priv-proto aes128
set priv-pwd "JQ-Lab_SNMPpriv#1"
set source-ip 10.38.0.0 255.255.0.0
next
end

config system snmp sysinfo
set status enable
set contact-info "admin@JQLab.local"
set description "JQLab-Core-40F"
set location "JQLab-Belgium-Lab"
end

config system snmp target-host
edit 1
set ip 10.38.100.23
set status enable
set snmp-version v3
set user-name "snmpadmin"
set source-ip 10.38.255.14
next
end
