### Partitioning
d-i partman-auto/disk string /dev/sda
d-i partman-auto/method string lvm
d-i partman-lvm/device_remove_lvm boolean true
d-i partman-auto/purge_lvm_from_device  boolean true
d-i partman-md/device_remove_md boolean true
d-i partman-auto/choose_recipe select atomic
d-i partman-lvm/confirm boolean true
# This makes partman automatically partition without confirmation
d-i partman-partitioning/confirm_write_new_label boolean true
d-i partman/choose_partition select finish
d-i partman/confirm boolean true
d-i partman/confirm_nooverwrite boolean true

# Locale
d-i debian-installer/locale string nl_BE
d-i console-setup/ask_detect boolean false
d-i console-setup/layoutcode string BE
d-i debconf/priority string critical
d-i auto-install/enable boolean true

# use -proposed udebs
d-i apt-setup/proposed boolean false

# minimal install (the only one not working!)
ubiquity ubiquity/minimal_install boolean true
d-i pkgsel/upgrade select none
d-i pkgsel/update-policy select none
d-i grub-installer/only_debian boolean true
d-i grub-installer/with_other_os boolean true

# Network
#d-i netcfg/get_hostname string unassigned-hostname
#d-i netcfg/get_domain string unassigned-domain
#d-i netcfg/choose_interface select auto

# Clock
d-i clock-setup/utc-auto boolean true
d-i clock-setup/utc boolean true
d-i time/zone string Europe/Brussels

#d-i clock-setup/ntp boolean true

# Packages, Mirrors, Image
#d-i base-installer/kernel/override-image string linux-server
#d-i base-installer/kernel/override-image string linux-image-amd64
#d-i mirror/country string Belgium
#d-i mirror/http/proxy string
#d-i apt-setup/restricted boolean true
#d-i apt-setup/universe boolean true
d-i pkgsel/install-language-support boolean false
d-i pkgsel/language-pack-patterns string 
tasksel tasksel/first multiselect ubuntu-desktop

# If you select ftp, the mirror/country string does not need to be set.
#d-i mirror/protocol string ftp
#d-i mirror/country string manual
#d-i mirror/http/hostname string http://ftp.belnet.be/ubuntu/
#d-i mirror/http/directory string /belnet
d-i mirror/http/proxy string

# Suite to install.
#d-i mirror/suite string testing
# Suite to use for loading installer components (optional).
#d-i mirror/udeb/suite string testing
#
# Users
d-i passwd/user-fullname string JQ
d-i passwd/username string JQ
d-i passwd/user-password password 1234
d-i passwd/user-password-again password 1234
d-i passwd/root-login boolean true
d-i passwd/root-password password 1234
d-i passwd/root-password-again password 1234
d-i user-setup/allow-password-weak boolean true

# Grub
d-i grub-installer/grub2_instead_of_grub_legacy boolean true
d-i grub-installer/only_debian boolean true
d-i finish-install/reboot_in_progress note
d-i preseed/late_command string in-target sed -i 's/GRUB_CMDLINE_LINUX_DEFAULT="quiet"/GRUB_CMDLINE_LINUX_DEFAULT="quiet splash nomodeset"/g' /etc/default/grub;
# Custom Commands
ubiquity ubiquity/success_command string \
  in-target apt update;\
ubiquity ubiquity/success_command string \
  in-target apt upgrade;\
ubiquity ubiquity/success_command string \
  in-target apt install sudo
ubiquity ubiquity/success_command string \
  in-target usermod -aG sudo JQ;\
ubiquity ubiquity/success_command string \
  in-target apt install openssh-server;\
ubiquity ubiquity/success_command string \
  in-target apt-key add Bacula-4096-Distribution-Verification-key.asc;\
ubiquity ubiquity/success_command string \
  in-target rm Bacula-4096-Distribution-Verification-key.asc;\
ubiquity ubiquity/success_command string \
  in-target echo "deb [arch=amd64] https://bacula.org/packages/5f1e8eefd1016/debs/11.0.6/jammy/amd64/jammy main" >> /etc/apt/sources.list;\
ubiquity ubiquity/success_command string \
  in-target apt update && apt install bacula-client;\

# Poweroff after install
#ubiquity ubiquity/poweroff boolean true
tasksel tasksel/first multiselect
ubiquity ubiquity/use_nonfree boolean true
ubiquity ubiquity/download_updates boolean false
# Reboot after install
ubiquity ubiquity/reboot boolean true